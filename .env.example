# Copy to .env (or set in your host) and adjust. Every value is optional.
PORT=3000
DB_PATH=./data/polampani.db

# Demo mode shows one-tap demo accounts and returns OTP codes in the API response.
# Set to false in production and configure SMS_WEBHOOK_URL so codes go out by SMS.
DEMO_MODE=true
SESSION_SECRET=change-me-to-a-long-random-string

# Re-alert wider when a job is still open after this many minutes.
ESCALATE_AFTER_MIN=10

# Optional: any OpenAI-compatible server with an open-weights model (for example Ollama).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# Optional: every alert and login code is POSTed here as {to, name, message}.
# SMS_WEBHOOK_URL=https://your-sms-gateway.example/send
# LOG_SMS=true

# Weather forecasts from Open-Meteo (free, no key). Set to false to disable.
WEATHER=true
